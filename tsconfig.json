{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"resolveJsonModule": true,
		"declaration": true
	},
	"include": ["src/**/*"]
}
