{
  "name": "mr-md",
  "version": "3.0.0-rc.3",
  "description": "Mr Markdown is an opinionated TypeScript SDK for building interactive learning pages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "md": "./dist/cli.js",
    "mr-md": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun run build",
    "build:docs": "bun docs-site/build.ts",
    "serve:docs": "bunx serve docs-site/out",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test && bun run typecheck",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "keywords": [
    "markdown",
    "blog",
    "interactive",
    "education",
    "shiki",
    "katex",
    "course"
  ],
  "author": "Chirayu Chhabra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chirayuChhabra/blogkit.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.9.3",
    "puppeteer": "^25.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.17.0",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "ts-morph": "^28.0.0"
  }
}
